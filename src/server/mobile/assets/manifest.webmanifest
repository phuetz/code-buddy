{
  "name": "Code Buddy Mobile",
  "short_name": "CodeBuddy",
  "description": "PWA pour piloter Code Buddy et dialoguer avec les assistants",
  "start_url": "/__codebuddy__/mobile/",
  "scope": "/__codebuddy__/mobile/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#1a1a2e",
  "background_color": "#1a1a2e",
  "icons": [
    {
      "src": "/__codebuddy__/mobile/assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Nouveau chat",
      "short_name": "Chat",
      "description": "Commencer un nouveau chat",
      "url": "/__codebuddy__/mobile/?section=chat",
      "icons": [
        {
          "src": "/__codebuddy__/mobile/assets/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Voir les runs",
      "short_name": "Runs",
      "description": "Voir l'historique des runs",
      "url": "/__codebuddy__/mobile/?section=runs",
      "icons": [
        {
          "src": "/__codebuddy__/mobile/assets/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "iarc_chain": [],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "web+codebuddy",
      "url": "/__codebuddy__/mobile/?token=%s"
    }
  ],
  "share_target": {
    "action": "/__codebuddy__/mobile/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "text/*"]
        }
      ]
    }
  }
}
