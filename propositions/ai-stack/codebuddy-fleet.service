[Unit]
Description=Code Buddy Fleet Gateway (port 3001 — fleet discovery + peer.dispatch)
Documentation=file:///home/patrice/DEV/code-buddy/docs/fleet-guide.md
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=patrice
WorkingDirectory=/home/patrice/DEV/code-buddy
EnvironmentFile=-/home/patrice/.codebuddy/fleet.env
# Force Node v24 to the front of PATH so `npx tsx` doesn't pick up the
# system Node v18 (npm v11 from v24 doesn't support it). systemd has
# no inherited PATH by default, so we set it explicitly.
Environment=PATH=/home/patrice/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin
# `--no-auth` only because the listener is bound to the Tailscale tailnet
# (cf. CLAUDE.md "Sécuriser réseau Ministar"). Switch to JWT once
# Sébastien is added to the ACL with a separate key.
ExecStart=/home/patrice/.nvm/versions/node/v24.14.1/bin/npx tsx src/index.ts server --port 3001 --host 0.0.0.0 --no-auth
Restart=on-failure
RestartSec=10
# Daily restart helps catch slow leaks before they accumulate.
RuntimeMaxSec=86400
StandardOutput=append:/var/log/codebuddy-fleet.log
StandardError=append:/var/log/codebuddy-fleet.log

[Install]
WantedBy=multi-user.target
