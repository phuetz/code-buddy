[0.118878,"o","\r\nAvailable AI Providers:\r\n\r\n  ❌ ChatGPT (OAuth)\r\n     Key: chatgpt\r\n"]
[0.119446,"o","     Env: CODEBUDDY_CHATGPT_OAUTH\r\n     Models: gpt-6-sol, gpt-6-astra, gpt-6-luna...\r\n\r\n  ❌ Google Antigravity (subscription)\r\n     Key: agy-cli\r\n     Env: none\r\n     Models: Gemini 3.1 Pro (High)\r\n\r\n  ✅ 🆓 Ollama\r\n     Key: ollama\r\n     Env: OLLAMA_HOST\r\n     Models: qwen2.5-coder:7b, llama3.2, mistral...\r\n\r\n  ✅ 🆓 Lemonade Server\r\n     Key: lemonade\r\n     Env: LEMONADE_HOST\r\n     Models: Qwen3.6-35B-A3B-MTP-GGUF\r\n\r\n  ❌ 🆓 LM Studio\r\n     Key: lmstudio\r\n     Env: LMSTUDIO_HOST | LM_STUDIO_HOST | LMSTUDIO_BASE_URL | LM_STUDIO_BASE_URL\r\n     Models: local-model, qwen2.5-coder, meta-llama-3.1-8b-instruct...\r\n\r\n  ❌ Grok (xAI) (active)\r\n     Key: grok\r\n     Env: GROK_API_KEY | XAI_API_KEY\r\n     Models: grok-4-1-fast, grok-code-fast-1, grok-3-fast...\r\n\r\n  ❌ Gemini (Google)\r\n     Key: gemini\r\n     Env: GOOGLE_API_KEY | GEMINI_API_KEY\r\n     Models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash...\r\n\r\n  ❌ OpenAI\r\n     Key: openai\r\n     Env: OPENAI_API_KEY\r\n     Models: gpt-5.6-sol, gpt-4o, gpt-4o-mini...\r\n\r\n  ❌ Claude (Anthropic)\r\n     Key: claude\r\n     Env: ANTHROPIC_API_KEY\r\n     Models: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-5-sonnet-latest\r\n\r\n  ❌ Mistral AI\r\n     Key: mistral\r\n     Env: MISTRAL_API_KEY\r\n     Models: mistral-large-latest, mistral-medium-latest, mistral-small-latest...\r\n\r\n  ❌ DeepSeek\r\n     Key: deepseek\r\n     Env: DEEPSEEK_API_KEY\r\n     Models: deepseek-chat, deepseek-reasoner, deepseek-v3.2\r\n\r\n  ❌ Groq\r\n     Key: groq\r\n     Env: GROQ_API_KEY\r\n     Models: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b...\r\n\r\n  ❌ Together AI\r\n     Key: together\r\n     Env: TOGETHER_API_KEY\r\n     Models: meta-llama/Llama-3.3-70B-Instruct-Turbo, mistralai/Mixtral-8x7B-Instruct-v0.1\r\n\r\n  ❌ Fireworks AI\r\n     Key: fireworks\r\n     Env: FIREWORKS_API_KEY\r\n     Models: accounts/fireworks/models/llama-v3p1-70b-instruct, accounts/fireworks/models/qwen2p5-coder-32b-instruct\r\n\r\n  ❌ OpenRouter\r\n     Key: openrouter\r\n     Env: OPENROUTER_API_KEY\r\n     Models: openrouter/free, openai/gpt-oss-20b:free, cohere/north-mini-code:free...\r\n\r\n  ❌ NovitaAI\r\n     Key: novita\r\n     Env: NOVITA_API_KEY\r\n     Models: moonshotai/kimi-k2.5, deepseek/deepseek-v3.2, qwen/qwen3-coder-480b-a35b-instruct\r\n\r\n  ❌ z.ai / GLM\r\n     Key: zai\r\n     Env: GLM_API_KEY | ZAI_API_KEY\r\n     Models: glm-5, glm-5-code, glm-4.7...\r\n\r\n  ❌ Kimi / Moonshot\r\n     Key: kimi-coding\r\n     Env: KIMI_API_KEY | MOONSHOT_API_KEY\r\n     Models: kimi-k2.5, kimi-k2-thinking, kimi-latest\r\n\r\n  ❌ Kimi / Moonshot China\r\n     Key: kimi-coding-cn\r\n     Env: KIMI_CN_API_KEY\r\n     Models: kimi-k2.5, kimi-k2-thinking, moonshot-v1-128k\r\n\r\n  ❌ Arcee AI\r\n     Key: arcee\r\n     Env: ARCEEAI_API_KEY | ARCEE_API_KEY\r\n     Models: trinity-large-thinking, trinity-mini, afm-4.5b\r\n\r\n  ❌ GMI Cloud\r\n     Key: gmi\r\n     Env: GMI_API_KEY\r\n     Models: deepseek-ai/DeepSeek-V3.2, zai-org/GLM-5.1-FP8, google/gemini-3.1-flash-lite\r\n\r\n  ❌ MiniMax\r\n     Key: minimax\r\n     Env: MINIMAX_API_KEY\r\n     Models: MiniMax-M2.7, MiniMax-M2.5, MiniMax-M2.1\r\n\r\n  ❌ MiniMax China\r\n     Key: minimax-cn\r\n     Env: MINIMAX_CN_API_KEY\r\n     Models: MiniMax-M2.7, MiniMax-M2.5, MiniMax-M2.1\r\n\r\n  ❌ Alibaba Cloud / DashScope\r\n     Key: alibaba\r\n     Env: DASHSCOPE_API_KEY | ALIBABA_API_KEY\r\n     Models: qwen3.5-plus, qwen3-coder-plus, qwen-plus\r\n\r\n  ❌ Alibaba Coding Plan\r\n     Key: alibaba-coding-plan\r\n     Env: ALIBABA_CODING_PLAN_API_KEY | DASHSCOPE_API_KEY\r\n     Models: qwen3-coder-plus, qwen3-coder-flash\r\n\r\n  ❌ Kilo Code Gateway\r\n     Key: kilocode\r\n     Env: KILOCODE_API_KEY | KILO_API_KEY\r\n     Models: kilocode-default\r\n\r\n  ❌ Xiaomi MiMo\r\n     Key: xiaomi\r\n     Env: XIAOMI_API_KEY\r\n     Models: mimo-v2-pro, mimo-v2-flash\r\n\r\n  ❌ Tencent TokenHub\r\n     Key: tencent-tokenhub\r\n     Env: TOKENHUB_API_KEY | TENCENT_TOKENHUB_API_KEY\r\n     Models: tencent-tokenhub/hy3-preview\r\n\r\n  ❌ OpenCode Zen\r\n     Key: opencode-zen\r\n     Env: OPENCODE_ZEN_API_KEY | OPENCODE_API_KEY\r\n     Models: opencode/claude-sonnet-4-5, opencode/gpt-5.1, opencode/glm-5.1\r\n\r\n  ❌ OpenCode Go\r\n     Key: opencode-go\r\n     Env: OPENCODE_GO_API_KEY\r\n     Models: deepseek-v4-flash, glm-5.1\r\n\r\n  ❌ Hug"]
