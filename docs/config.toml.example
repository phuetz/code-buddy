# Exemple de configuration Code Buddy
# Généré depuis le schéma TOML. Chaque clé d'écriture a un marqueur « cle: ».
# Le défaut est indiqué en commentaire. Une clé absente du fichier réel n'est pas inventée à l'écriture.
# Les adresses d'exemple ne sont pas des services. Aucune clé secrète n'est écrite ici.
# model_id, mode replace, les rôles autres que primary et le cache de fenêtre ne sont pas des clés d'écriture.
# Chaque table n'est ouverte qu'une fois. Une clé qui est déjà une table n'est pas aussi une valeur.

# cle: active_model
# défaut : grok-code-fast
# Modèle actif. La valeur du fichier généré ne masque pas le fournisseur détecté
active_model = "grok-code-fast"

# cle: advisor
# défaut : absent
# Second avis

[advisor]
# cle: advisor.api_key_env
# défaut : absent
# Variable de la clé du second avis, jamais la clé
api_key_env = "EXAMPLE_API_KEY"

# cle: advisor.base_url
# défaut : absent
# URL du second avis
base_url = "https://example.invalid/v1"

# cle: advisor.enabled
# défaut : absent
# Second avis activé
enabled = false

# cle: advisor.model
# défaut : absent
# Modèle du second avis
model = "exemple"

# cle: agent
# défaut : absent
# Comportement de l'agent

[agent]
# cle: agent.architect_model
# défaut : absent
# Modèle de planification
architect_model = "exemple"

# cle: agent.default_prompt
# défaut : default
# Identifiant du prompt système
default_prompt = "default"

# cle: agent.editor_model
# défaut : absent
# Modèle d'édition
editor_model = "exemple"

# cle: agent.parallel_tools
# défaut : false
# Outils en parallèle
parallel_tools = false

# cle: agent.rag_tool_selection
# défaut : true
# Sélection d'outils par similarité
rag_tool_selection = true

# cle: agent.self_healing
# défaut : true
# Réparation proposée après une erreur
self_healing = true

# cle: agent.yolo_mode
# défaut : false
# Autonomie élargie
yolo_mode = false

# cle: agent_defaults
# défaut : absent
# Réglages par agent

[agent_defaults]
# cle: agent_defaults.imageGenerationModel
# défaut : absent
# Modèle de génération d'image
imageGenerationModel = "exemple"

# cle: agent_defaults.agents
# défaut : absent
# Réglages par agent

# cle: agent_defaults.agents.*
# défaut : absent

[agent_defaults.agents.exemple]
# cle: agent_defaults.agents.*.maxTokens
# défaut : absent
# Jetons de sortie
maxTokens = 0

# cle: agent_defaults.agents.*.model
# défaut : absent
# Modèle de cet agent
model = "exemple"

# cle: agent_defaults.agents.*.temperature
# défaut : absent
# Température
temperature = 0

# cle: autonomous_fleet
# défaut : absent
# Flotte autonome

[autonomous_fleet]
# cle: autonomous_fleet.enabled
# défaut : false
# Battement autonome de flotte
enabled = false

# cle: autonomous_fleet.host
# défaut : absent
# Nom d'hôte annoncé
host = "exemple"

# cle: autonomous_fleet.interval_minutes
# défaut : 30
# Intervalle en minutes
interval_minutes = 30

# cle: autonomous_fleet.llm_provider
# défaut : cloud
# Fournisseur des tâches autonomes
llm_provider = "cloud"

# cle: autonomous_fleet.max_task_ms
# défaut : 600000
# Durée maximale d'une tâche, en millisecondes
max_task_ms = 600000

# cle: autonomous_fleet.priority_threshold
# défaut : high
# Priorité la plus basse acceptée
priority_threshold = "high"

# cle: autonomous_fleet.repo_path
# défaut : absent
# Dépôt qui sert de bus
repo_path = "exemple"

# cle: catalogue
# défaut : absent
# Mode du catalogue

[catalogue]
# cle: catalogue.mode
# défaut : merge
# Seul mode accepté. Une entrée ne remplace que les champs qu'elle écrit
mode = "merge"

# cle: channels
# défaut : absent
# Canaux de messagerie

# cle: channels.*
# défaut : absent

[channels.exemple]
# cle: channels.*.dm_policy
# défaut : absent
# Messages privés. disabled est plus fermé
dm_policy = "open"

# cle: channels.*.enabled
# défaut : absent
# Canal utilisable
enabled = false

# cle: channels.*.group_policy
# défaut : absent
# Accueil des groupes. allowlist est plus fermé que open
group_policy = "open"

# cle: daily_reset
# défaut : absent
# Remise à zéro quotidienne

[daily_reset]
# cle: daily_reset.enabled
# défaut : false
# Remise à zéro quotidienne
enabled = false

# cle: daily_reset.idle_minutes
# défaut : 0
# Inactivité avant remise à zéro, 0 pour désactiver
idle_minutes = 0

# cle: daily_reset.post_summary
# défaut : true
# Publier un résumé
post_summary = true

# cle: daily_reset.reset_hour
# défaut : 4
# Heure, 0 à 23
reset_hour = 4

# cle: daily_reset.reset_minute
# défaut : 0
# Minute, 0 à 59
reset_minute = 0

# cle: daily_reset.timezone
# défaut : absent
# Fuseau horaire
timezone = "exemple"

# cle: enterprise_modules
# défaut : absent
# Modules d'entreprise

[enterprise_modules]
# cle: enterprise_modules.enabled
# défaut : false
# Interrupteur des modules
enabled = false

# cle: enterprise_modules.plugin_conflict_detector
# défaut : absent
# Détecteur de conflit de greffons

[enterprise_modules.plugin_conflict_detector]
# cle: enterprise_modules.plugin_conflict_detector.enabled
# défaut : absent
# Module activé
enabled = false

# cle: enterprise_modules.retry_fallback_engine
# défaut : absent
# Repli de nouvelle tentative, inactif par défaut

[enterprise_modules.retry_fallback_engine]
# cle: enterprise_modules.retry_fallback_engine.enabled
# défaut : absent
# Module activé
enabled = false

# cle: enterprise_modules.semantic_memory_search
# défaut : absent
# Recherche sémantique supplémentaire, inactive par défaut

[enterprise_modules.semantic_memory_search]
# cle: enterprise_modules.semantic_memory_search.enabled
# défaut : absent
# Module activé
enabled = false

# cle: enterprise_modules.smart_compaction_engine
# défaut : absent
# Compactage supplémentaire, inactif par défaut

[enterprise_modules.smart_compaction_engine]
# cle: enterprise_modules.smart_compaction_engine.enabled
# défaut : absent
# Module activé
enabled = false

# cle: enterprise_modules.tool_lifecycle_hooks
# défaut : absent
# Crochets de cycle de vie, inactifs par défaut

[enterprise_modules.tool_lifecycle_hooks]
# cle: enterprise_modules.tool_lifecycle_hooks.enabled
# défaut : absent
# Module activé
enabled = false

# cle: enterprise_modules.tool_policy_engine
# défaut : absent
# Moteur de politique d'outils, inactif par défaut

[enterprise_modules.tool_policy_engine]
# cle: enterprise_modules.tool_policy_engine.enabled
# défaut : absent
# Module activé
enabled = false

# cle: exec
# défaut : absent
# Approbations d'exécution

[exec]
# cle: exec.allow_commands
# défaut : absent
# Commandes pré-autorisées. Une politique ne peut pas en ajouter
allow_commands = ["exemple"]

# cle: exec.approvals
# défaut : absent
# Approbation des commandes. always est plus fermé que off
approvals = "off"

# cle: exec.deny_commands
# défaut : absent
# Fragments de commande refusés
deny_commands = ["exemple"]

# cle: gateway
# défaut : absent
# Passerelle

[gateway]
# cle: gateway.auth_mode
# défaut : absent
# Authentification. none est plus ouvert que token
auth_mode = "token"

# cle: gateway.bind
# défaut : absent
# Écoute. lan est plus ouvert que loopback
bind = "loopback"

# cle: gateway.port
# défaut : absent
# Port de la passerelle. DIAGNOSTIC NON APPLIQUÉ : la valeur peut être enregistrée, elle ne change pas l'écoute
port = 3000

# cle: heartbeat
# défaut : absent
# Battement

[heartbeat]
# cle: heartbeat.active_hours_end
# défaut : 22
# Heure de fin, 0 à 23
active_hours_end = 22

# cle: heartbeat.active_hours_start
# défaut : 8
# Heure de début, 0 à 23
active_hours_start = 8

# cle: heartbeat.enabled
# défaut : false
# Battement périodique
enabled = false

# cle: heartbeat.heartbeat_file
# défaut : .codebuddy/HEARTBEAT.md
# Liste de contrôle
heartbeat_file = ".codebuddy/HEARTBEAT.md"

# cle: heartbeat.interval_minutes
# défaut : 30
# Intervalle en minutes
interval_minutes = 30

# cle: heartbeat.max_consecutive_suppressions
# défaut : 5
# Relances silencieuses avant une revue
max_consecutive_suppressions = 5

# cle: heartbeat.suppression_keyword
# défaut : HEARTBEAT_OK
# Mot qui évite une relance
suppression_keyword = "HEARTBEAT_OK"

# cle: integrations
# défaut : absent
# Intégrations

[integrations]
# cle: integrations.icm_enabled
# défaut : true
# Mémoire de contexte persistante
icm_enabled = true

# cle: integrations.rtk_enabled
# défaut : false
# Compression des sorties de commandes, désactivée par défaut
rtk_enabled = false

# cle: integrations.rtk_min_output_length
# défaut : 500
# Longueur minimale avant compression
rtk_min_output_length = 500

# cle: llm
# défaut : absent
# Repli de fournisseur

[llm]
# cle: llm.enabled
# défaut : false
# Repli automatique entre fournisseurs
enabled = false

# cle: llm.local_only
# défaut : absent
# Limiter le repli aux exécutions locales
local_only = false

# cle: llm.manualOrder
# défaut : absent
# Ordre manuel des fournisseurs
manualOrder = ["exemple"]

# cle: llm.order
# défaut : absent
# Ordre du repli
order = "resilience"

# cle: llm.together_strategy
# défaut : absent
# Stratégie collective
together_strategy = "ensemble"

# cle: lsp
# défaut : absent
# Serveur de langage

# cle: lsp.aiCompletion
# défaut : absent
# Complétions

[lsp.aiCompletion]
# cle: lsp.aiCompletion.debounceMs
# défaut : absent
# Délai avant une demande, en millisecondes
debounceMs = 0

# cle: lsp.aiCompletion.enabled
# défaut : absent
# Complétions inline
enabled = false

# cle: lsp.aiCompletion.maxSuggestions
# défaut : absent
# Nombre de suggestions
maxSuggestions = 0

# cle: lsp.aiCompletion.maxTokens
# défaut : absent
# Jetons par suggestion
maxTokens = 0

# cle: lsp.aiCompletion.model
# défaut : absent
# Modèle des complétions
model = "exemple"

# cle: mcp
# défaut : absent
# Serveurs MCP

[mcp]
# cle: mcp.allow_write
# défaut : absent
# Écriture via les serveurs. false retire une autorisation
allow_write = false

# cle: mcp.enabled_servers
# défaut : absent
# Serveurs que la configuration active
enabled_servers = ["exemple"]

# cle: middleware
# défaut : absent
# Limites de session

[middleware]
# cle: middleware.auto_compact_threshold
# défaut : 80000
# Seuil de compactage automatique, en jetons
auto_compact_threshold = 80000

# cle: middleware.context_warning_percentage
# défaut : 0.7
# Seuil d'avertissement du contexte, entre 0 et 1
context_warning_percentage = 0.7

# cle: middleware.cost_warning_threshold
# défaut : 0.8
# Seuil d'avertissement du coût, entre 0 et 1
cost_warning_threshold = 0.8

# cle: middleware.max_cost
# défaut : 10
# Plafond de coût de session
max_cost = 10

# cle: middleware.max_turns
# défaut : 100
# Tours maximum
max_turns = 100

# cle: middleware.turn_warning_threshold
# défaut : 0.8
# Seuil d'avertissement des tours, entre 0 et 1
turn_warning_threshold = 0.8

# cle: model_aliases
# défaut : absent
# Alias résolus avant le catalogue. Chaîne, ou table model, provider et base_url

# cle: model_aliases.*
# défaut : absent
# Cible d'un alias

[model_aliases.exemple]
# cle: model_aliases.*.base_url
# défaut : absent
# URL réellement utilisée par la session. Absente : l'URL du fournisseur nommé par l'alias, sinon l'URL déjà choisie
base_url = "https://example.invalid/v1"

# cle: model_aliases.*.model
# défaut : absent
# Nom de modèle, ou un autre alias
model = "grok-4"

# cle: model_aliases.*.provider
# défaut : absent
# Fournisseur réellement utilisé par la session. Absent : le fournisseur détecté reste
provider = "openai"

# cle: model_pairs
# défaut : absent
# Paire architecte et éditeur

[model_pairs]
# cle: model_pairs.architect
# défaut : absent
# Modèle qui planifie
architect = "exemple"

# cle: model_pairs.editor
# défaut : absent
# Modèle qui modifie
editor = "exemple"

# cle: model_roles
# défaut : absent
# Rôles. Seul primary est lu

[model_roles]
# cle: model_roles.primary
# défaut : absent
# Modèle principal de la session
primary = "exemple"

# cle: models
# défaut : absent
# Modèles déclarés

# cle: models.*
# défaut : absent

[models.exemple]
# cle: models.*.context_window
# défaut : absent
# Alias de la fenêtre de contexte
context_window = 1

# cle: models.*.description
# défaut : absent
# Libellé affiché
description = "exemple"

# cle: models.*.input
# défaut : absent
# Modalités d'entrée : text et image
input = ["text"]

# cle: models.*.max_context_tokens
# défaut : absent
# Fenêtre de contexte déclarée
max_context_tokens = 1

# cle: models.*.max_output_tokens
# défaut : absent
# Alias du plafond de sortie
max_output_tokens = 1

# cle: models.*.max_tokens
# défaut : absent
# Plafond de sortie
max_tokens = 1

# cle: models.*.price_per_m_input
# défaut : absent
# Prix d'un million de jetons entrants. À écrire avec le prix sortant
price_per_m_input = 0

# cle: models.*.price_per_m_output
# défaut : absent
# Prix d'un million de jetons sortants. À écrire avec le prix entrant
price_per_m_output = 0

# cle: models.*.provider
# défaut : absent
# Colonne historique. Elle ne choisit pas le fournisseur de la session
provider = "exemple"

# cle: models.*.reasoning
# défaut : absent
# Le modèle raisonne
reasoning = false

# cle: models.*.tools
# défaut : absent
# Le modèle appelle des outils
tools = false

# cle: models.*.vision
# défaut : absent
# Le modèle accepte une image. Si cette clé est absente, input peut la déduire
vision = false

# cle: multi_agent_system
# défaut : absent
# Système multi-agent

[multi_agent_system]
# cle: multi_agent_system.cost_warning_threshold_percent
# défaut : 0.8
# Seuil d'avertissement du coût
cost_warning_threshold_percent = 0.8

# cle: multi_agent_system.default_strategy
# défaut : hierarchical
# Stratégie
default_strategy = "sequential"

# cle: multi_agent_system.enabled
# défaut : false
# Système multi-agent
enabled = false

# cle: multi_agent_system.graceful_cost_overflow
# défaut : true
# Arrêt propre au plafond
graceful_cost_overflow = true

# cle: multi_agent_system.max_iterations
# défaut : 5
# Itérations
max_iterations = 5

# cle: multi_agent_system.max_workflow_cost_usd
# défaut : 0
# Plafond de coût, 0 pour désactiver
max_workflow_cost_usd = 0

# cle: multi_agent_system.parallel_agents
# défaut : 3
# Agents en parallèle
parallel_agents = 3

# cle: multi_agent_system.timeout_ms
# défaut : 600000
# Délai d'un flux, en millisecondes
timeout_ms = 600000

# cle: multi_agent_system.coordination
# défaut : absent
# Coordinateur

[multi_agent_system.coordination]
# cle: multi_agent_system.coordination.auto_resolve_enabled
# défaut : false
# Résolution automatique des conflits
auto_resolve_enabled = false

# cle: multi_agent_system.coordination.auto_resolve_strategy
# défaut : none
# Stratégie de résolution
auto_resolve_strategy = "prefer-reviewer"

# cle: multi_agent_system.coordination.checkpoint_interval
# défaut : 5
# Tâches entre deux points de reprise
checkpoint_interval = 5

# cle: multi_agent_system.coordination.conflict_timeout
# défaut : 30000
# Délai de conflit, en millisecondes
conflict_timeout = 30000

# cle: multi_agent_system.coordination.enable_adaptive_allocation
# défaut : true
# Répartition adaptative
enable_adaptive_allocation = true

# cle: multi_agent_system.coordination.enable_conflict_resolution
# défaut : true
# Détection de conflits
enable_conflict_resolution = true

# cle: multi_agent_system.coordination.enable_learning
# défaut : true
# Apprentissage de la répartition
enable_learning = true

# cle: multi_agent_system.coordination.enable_per_workflow_stop
# défaut : false
# Arrêt d'un seul flux
enable_per_workflow_stop = false

# cle: multi_agent_system.coordination.enable_persistence
# défaut : false
# Conserver les métriques
enable_persistence = false

# cle: multi_agent_system.coordination.enabled
# défaut : false
# Coordinateur avancé
enabled = false

# cle: multi_agent_system.coordination.history_size
# défaut : 50
# Taille de l'historique
history_size = 50

# cle: multi_agent_system.coordination.max_concurrent_workflows
# défaut : 1
# Flux simultanés
max_concurrent_workflows = 1

# cle: multi_agent_system.coordination.max_parallel_per_agent
# défaut : 2
# Tâches parallèles par agent
max_parallel_per_agent = 2

# cle: multi_agent_system.coordination.metrics_ttl_days
# défaut : 30
# Jours avant qu'une métrique soit périmée
metrics_ttl_days = 30

# cle: multi_agent_system.coordination.min_assignment_confidence
# défaut : 0.6
# Confiance minimale
min_assignment_confidence = 0.6

# cle: multi_agent_system.coordination.queue_policy
# défaut : queue
# File pleine
queue_policy = "queue"

# cle: multi_agent_system.sessions
# défaut : absent
# Registre de sessions

[multi_agent_system.sessions]
# cle: multi_agent_system.sessions.enable_persistence
# défaut : true
# Écrire les sessions
enable_persistence = true

# cle: multi_agent_system.sessions.enabled
# défaut : false
# Registre de sessions
enabled = false

# cle: multi_agent_system.sessions.idle_timeout_minutes
# défaut : 30
# Inactivité avant nettoyage
idle_timeout_minutes = 30

# cle: multi_agent_system.sessions.max_per_workflow
# défaut : 10
# Sous-agents par flux
max_per_workflow = 10

# cle: multi_agent_system.sessions.max_sessions
# défaut : 1000
# Sessions conservées
max_sessions = 1000

# cle: multi_agent_system.sessions.max_spawn_per_minute
# défaut : 0
# Créations par minute, 0 pour désactiver
max_spawn_per_minute = 0

# cle: multi_agent_system.sessions.require_confirmation_for_send
# défaut : false
# Confirmer un envoi
require_confirmation_for_send = false

# cle: multi_agent_system.sessions.require_confirmation_for_spawn
# défaut : false
# Confirmer une création
require_confirmation_for_spawn = false

# cle: profiles
# défaut : absent
# Profils nommés, activés avec --profile

# cle: profiles.*
# défaut : absent

[profiles.exemple]
# cle: profiles.*.active_model
# défaut : absent
# Modèle du profil, ou modèle actif à la racine
active_model = "exemple"

# cle: profiles.*.advisor
# défaut : absent
# Second avis

[profiles.exemple.advisor]
# cle: profiles.*.advisor.api_key_env
# défaut : absent
# Variable de la clé du second avis, jamais la clé
api_key_env = "EXAMPLE_API_KEY"

# cle: profiles.*.advisor.base_url
# défaut : absent
# URL du second avis
base_url = "https://example.invalid/v1"

# cle: profiles.*.advisor.enabled
# défaut : absent
# Second avis activé
enabled = false

# cle: profiles.*.advisor.model
# défaut : absent
# Modèle du second avis
model = "exemple"

# cle: profiles.*.agent
# défaut : absent
# Comportement de l'agent

[profiles.exemple.agent]
# cle: profiles.*.agent.architect_model
# défaut : absent
# Modèle de planification
architect_model = "exemple"

# cle: profiles.*.agent.default_prompt
# défaut : default
# Identifiant du prompt système
default_prompt = "default"

# cle: profiles.*.agent.editor_model
# défaut : absent
# Modèle d'édition
editor_model = "exemple"

# cle: profiles.*.agent.parallel_tools
# défaut : false
# Outils en parallèle
parallel_tools = false

# cle: profiles.*.agent.rag_tool_selection
# défaut : true
# Sélection d'outils par similarité
rag_tool_selection = true

# cle: profiles.*.agent.self_healing
# défaut : true
# Réparation proposée après une erreur
self_healing = true

# cle: profiles.*.agent.yolo_mode
# défaut : false
# Autonomie élargie
yolo_mode = false

# cle: profiles.*.agent_defaults
# défaut : absent
# Réglages par agent

[profiles.exemple.agent_defaults]
# cle: profiles.*.agent_defaults.imageGenerationModel
# défaut : absent
# Modèle de génération d'image
imageGenerationModel = "exemple"

# cle: profiles.*.agent_defaults.agents
# défaut : absent
# Réglages par agent

# cle: profiles.*.agent_defaults.agents.*
# défaut : absent

[profiles.exemple.agent_defaults.agents.exemple]
# cle: profiles.*.agent_defaults.agents.*.maxTokens
# défaut : absent
# Jetons de sortie
maxTokens = 0

# cle: profiles.*.agent_defaults.agents.*.model
# défaut : absent
# Modèle de cet agent
model = "exemple"

# cle: profiles.*.agent_defaults.agents.*.temperature
# défaut : absent
# Température
temperature = 0

# cle: profiles.*.autonomous_fleet
# défaut : absent
# Flotte autonome

[profiles.exemple.autonomous_fleet]
# cle: profiles.*.autonomous_fleet.enabled
# défaut : false
# Battement autonome de flotte
enabled = false

# cle: profiles.*.autonomous_fleet.host
# défaut : absent
# Nom d'hôte annoncé
host = "exemple"

# cle: profiles.*.autonomous_fleet.interval_minutes
# défaut : 30
# Intervalle en minutes
interval_minutes = 30

# cle: profiles.*.autonomous_fleet.llm_provider
# défaut : cloud
# Fournisseur des tâches autonomes
llm_provider = "cloud"

# cle: profiles.*.autonomous_fleet.max_task_ms
# défaut : 600000
# Durée maximale d'une tâche, en millisecondes
max_task_ms = 600000

# cle: profiles.*.autonomous_fleet.priority_threshold
# défaut : high
# Priorité la plus basse acceptée
priority_threshold = "high"

# cle: profiles.*.autonomous_fleet.repo_path
# défaut : absent
# Dépôt qui sert de bus
repo_path = "exemple"

# cle: profiles.*.catalogue
# défaut : absent
# Mode du catalogue

[profiles.exemple.catalogue]
# cle: profiles.*.catalogue.mode
# défaut : merge
# Seul mode accepté. Une entrée ne remplace que les champs qu'elle écrit
mode = "merge"

# cle: profiles.*.channels
# défaut : absent
# Canaux de messagerie

# cle: profiles.*.channels.*
# défaut : absent

[profiles.exemple.channels.exemple]
# cle: profiles.*.channels.*.dm_policy
# défaut : absent
# Messages privés. disabled est plus fermé
dm_policy = "open"

# cle: profiles.*.channels.*.enabled
# défaut : absent
# Canal utilisable
enabled = false

# cle: profiles.*.channels.*.group_policy
# défaut : absent
# Accueil des groupes. allowlist est plus fermé que open
group_policy = "open"

# cle: profiles.*.daily_reset
# défaut : absent
# Remise à zéro quotidienne

[profiles.exemple.daily_reset]
# cle: profiles.*.daily_reset.enabled
# défaut : false
# Remise à zéro quotidienne
enabled = false

# cle: profiles.*.daily_reset.idle_minutes
# défaut : 0
# Inactivité avant remise à zéro, 0 pour désactiver
idle_minutes = 0

# cle: profiles.*.daily_reset.post_summary
# défaut : true
# Publier un résumé
post_summary = true

# cle: profiles.*.daily_reset.reset_hour
# défaut : 4
# Heure, 0 à 23
reset_hour = 4

# cle: profiles.*.daily_reset.reset_minute
# défaut : 0
# Minute, 0 à 59
reset_minute = 0

# cle: profiles.*.daily_reset.timezone
# défaut : absent
# Fuseau horaire
timezone = "exemple"

# cle: profiles.*.enterprise_modules
# défaut : absent
# Modules d'entreprise

[profiles.exemple.enterprise_modules]
# cle: profiles.*.enterprise_modules.enabled
# défaut : false
# Interrupteur des modules
enabled = false

# cle: profiles.*.enterprise_modules.plugin_conflict_detector
# défaut : absent
# Détecteur de conflit de greffons

[profiles.exemple.enterprise_modules.plugin_conflict_detector]
# cle: profiles.*.enterprise_modules.plugin_conflict_detector.enabled
# défaut : absent
# Module activé
enabled = false

# cle: profiles.*.enterprise_modules.retry_fallback_engine
# défaut : absent
# Repli de nouvelle tentative, inactif par défaut

[profiles.exemple.enterprise_modules.retry_fallback_engine]
# cle: profiles.*.enterprise_modules.retry_fallback_engine.enabled
# défaut : absent
# Module activé
enabled = false

# cle: profiles.*.enterprise_modules.semantic_memory_search
# défaut : absent
# Recherche sémantique supplémentaire, inactive par défaut

[profiles.exemple.enterprise_modules.semantic_memory_search]
# cle: profiles.*.enterprise_modules.semantic_memory_search.enabled
# défaut : absent
# Module activé
enabled = false

# cle: profiles.*.enterprise_modules.smart_compaction_engine
# défaut : absent
# Compactage supplémentaire, inactif par défaut

[profiles.exemple.enterprise_modules.smart_compaction_engine]
# cle: profiles.*.enterprise_modules.smart_compaction_engine.enabled
# défaut : absent
# Module activé
enabled = false

# cle: profiles.*.enterprise_modules.tool_lifecycle_hooks
# défaut : absent
# Crochets de cycle de vie, inactifs par défaut

[profiles.exemple.enterprise_modules.tool_lifecycle_hooks]
# cle: profiles.*.enterprise_modules.tool_lifecycle_hooks.enabled
# défaut : absent
# Module activé
enabled = false

# cle: profiles.*.enterprise_modules.tool_policy_engine
# défaut : absent
# Moteur de politique d'outils, inactif par défaut

[profiles.exemple.enterprise_modules.tool_policy_engine]
# cle: profiles.*.enterprise_modules.tool_policy_engine.enabled
# défaut : absent
# Module activé
enabled = false

# cle: profiles.*.exec
# défaut : absent
# Approbations d'exécution

[profiles.exemple.exec]
# cle: profiles.*.exec.allow_commands
# défaut : absent
# Commandes pré-autorisées. Une politique ne peut pas en ajouter
allow_commands = ["exemple"]

# cle: profiles.*.exec.approvals
# défaut : absent
# Approbation des commandes. always est plus fermé que off
approvals = "off"

# cle: profiles.*.exec.deny_commands
# défaut : absent
# Fragments de commande refusés
deny_commands = ["exemple"]

# cle: profiles.*.gateway
# défaut : absent
# Passerelle

[profiles.exemple.gateway]
# cle: profiles.*.gateway.auth_mode
# défaut : absent
# Authentification. none est plus ouvert que token
auth_mode = "token"

# cle: profiles.*.gateway.bind
# défaut : absent
# Écoute. lan est plus ouvert que loopback
bind = "loopback"

# cle: profiles.*.gateway.port
# défaut : absent
# Port de la passerelle. DIAGNOSTIC NON APPLIQUÉ : la valeur peut être enregistrée, elle ne change pas l'écoute
port = 3000

# cle: profiles.*.heartbeat
# défaut : absent
# Battement

[profiles.exemple.heartbeat]
# cle: profiles.*.heartbeat.active_hours_end
# défaut : 22
# Heure de fin, 0 à 23
active_hours_end = 22

# cle: profiles.*.heartbeat.active_hours_start
# défaut : 8
# Heure de début, 0 à 23
active_hours_start = 8

# cle: profiles.*.heartbeat.enabled
# défaut : false
# Battement périodique
enabled = false

# cle: profiles.*.heartbeat.heartbeat_file
# défaut : .codebuddy/HEARTBEAT.md
# Liste de contrôle
heartbeat_file = ".codebuddy/HEARTBEAT.md"

# cle: profiles.*.heartbeat.interval_minutes
# défaut : 30
# Intervalle en minutes
interval_minutes = 30

# cle: profiles.*.heartbeat.max_consecutive_suppressions
# défaut : 5
# Relances silencieuses avant une revue
max_consecutive_suppressions = 5

# cle: profiles.*.heartbeat.suppression_keyword
# défaut : HEARTBEAT_OK
# Mot qui évite une relance
suppression_keyword = "HEARTBEAT_OK"

# cle: profiles.*.integrations
# défaut : absent
# Intégrations

[profiles.exemple.integrations]
# cle: profiles.*.integrations.icm_enabled
# défaut : true
# Mémoire de contexte persistante
icm_enabled = true

# cle: profiles.*.integrations.rtk_enabled
# défaut : false
# Compression des sorties de commandes, désactivée par défaut
rtk_enabled = false

# cle: profiles.*.integrations.rtk_min_output_length
# défaut : 500
# Longueur minimale avant compression
rtk_min_output_length = 500

# cle: profiles.*.llm
# défaut : absent
# Repli de fournisseur

[profiles.exemple.llm]
# cle: profiles.*.llm.enabled
# défaut : false
# Repli automatique entre fournisseurs
enabled = false

# cle: profiles.*.llm.local_only
# défaut : absent
# Limiter le repli aux exécutions locales
local_only = false

# cle: profiles.*.llm.manualOrder
# défaut : absent
# Ordre manuel des fournisseurs
manualOrder = ["exemple"]

# cle: profiles.*.llm.order
# défaut : absent
# Ordre du repli
order = "resilience"

# cle: profiles.*.llm.together_strategy
# défaut : absent
# Stratégie collective
together_strategy = "ensemble"

# cle: profiles.*.lsp
# défaut : absent
# Serveur de langage

# cle: profiles.*.lsp.aiCompletion
# défaut : absent
# Complétions

[profiles.exemple.lsp.aiCompletion]
# cle: profiles.*.lsp.aiCompletion.debounceMs
# défaut : absent
# Délai avant une demande, en millisecondes
debounceMs = 0

# cle: profiles.*.lsp.aiCompletion.enabled
# défaut : absent
# Complétions inline
enabled = false

# cle: profiles.*.lsp.aiCompletion.maxSuggestions
# défaut : absent
# Nombre de suggestions
maxSuggestions = 0

# cle: profiles.*.lsp.aiCompletion.maxTokens
# défaut : absent
# Jetons par suggestion
maxTokens = 0

# cle: profiles.*.lsp.aiCompletion.model
# défaut : absent
# Modèle des complétions
model = "exemple"

# cle: profiles.*.mcp
# défaut : absent
# Serveurs MCP

[profiles.exemple.mcp]
# cle: profiles.*.mcp.allow_write
# défaut : absent
# Écriture via les serveurs. false retire une autorisation
allow_write = false

# cle: profiles.*.mcp.enabled_servers
# défaut : absent
# Serveurs que la configuration active
enabled_servers = ["exemple"]

# cle: profiles.*.middleware
# défaut : absent
# Limites de session

[profiles.exemple.middleware]
# cle: profiles.*.middleware.auto_compact_threshold
# défaut : 80000
# Seuil de compactage automatique, en jetons
auto_compact_threshold = 80000

# cle: profiles.*.middleware.context_warning_percentage
# défaut : 0.7
# Seuil d'avertissement du contexte, entre 0 et 1
context_warning_percentage = 0.7

# cle: profiles.*.middleware.cost_warning_threshold
# défaut : 0.8
# Seuil d'avertissement du coût, entre 0 et 1
cost_warning_threshold = 0.8

# cle: profiles.*.middleware.max_cost
# défaut : 10
# Plafond de coût de session
max_cost = 10

# cle: profiles.*.middleware.max_turns
# défaut : 100
# Tours maximum
max_turns = 100

# cle: profiles.*.middleware.turn_warning_threshold
# défaut : 0.8
# Seuil d'avertissement des tours, entre 0 et 1
turn_warning_threshold = 0.8

# cle: profiles.*.model_aliases
# défaut : absent
# Alias résolus avant le catalogue. Chaîne, ou table model, provider et base_url

# cle: profiles.*.model_aliases.*
# défaut : absent
# Cible d'un alias

[profiles.exemple.model_aliases.exemple]
# cle: profiles.*.model_aliases.*.base_url
# défaut : absent
# URL réellement utilisée par la session. Absente : l'URL du fournisseur nommé par l'alias, sinon l'URL déjà choisie
base_url = "https://example.invalid/v1"

# cle: profiles.*.model_aliases.*.model
# défaut : absent
# Nom de modèle, ou un autre alias
model = "grok-4"

# cle: profiles.*.model_aliases.*.provider
# défaut : absent
# Fournisseur réellement utilisé par la session. Absent : le fournisseur détecté reste
provider = "openai"

# cle: profiles.*.model_pairs
# défaut : absent
# Paire architecte et éditeur

[profiles.exemple.model_pairs]
# cle: profiles.*.model_pairs.architect
# défaut : absent
# Modèle qui planifie
architect = "exemple"

# cle: profiles.*.model_pairs.editor
# défaut : absent
# Modèle qui modifie
editor = "exemple"

# cle: profiles.*.model_roles
# défaut : absent
# Rôles. Seul primary est lu

[profiles.exemple.model_roles]
# cle: profiles.*.model_roles.primary
# défaut : absent
# Modèle principal de la session
primary = "exemple"

# cle: profiles.*.models
# défaut : absent
# Modèles déclarés

# cle: profiles.*.models.*
# défaut : absent

[profiles.exemple.models.exemple]
# cle: profiles.*.models.*.context_window
# défaut : absent
# Alias de la fenêtre de contexte
context_window = 1

# cle: profiles.*.models.*.description
# défaut : absent
# Libellé affiché
description = "exemple"

# cle: profiles.*.models.*.input
# défaut : absent
# Modalités d'entrée : text et image
input = ["text"]

# cle: profiles.*.models.*.max_context_tokens
# défaut : absent
# Fenêtre de contexte déclarée
max_context_tokens = 1

# cle: profiles.*.models.*.max_output_tokens
# défaut : absent
# Alias du plafond de sortie
max_output_tokens = 1

# cle: profiles.*.models.*.max_tokens
# défaut : absent
# Plafond de sortie
max_tokens = 1

# cle: profiles.*.models.*.price_per_m_input
# défaut : absent
# Prix d'un million de jetons entrants. À écrire avec le prix sortant
price_per_m_input = 0

# cle: profiles.*.models.*.price_per_m_output
# défaut : absent
# Prix d'un million de jetons sortants. À écrire avec le prix entrant
price_per_m_output = 0

# cle: profiles.*.models.*.provider
# défaut : absent
# Colonne historique. Elle ne choisit pas le fournisseur de la session
provider = "exemple"

# cle: profiles.*.models.*.reasoning
# défaut : absent
# Le modèle raisonne
reasoning = false

# cle: profiles.*.models.*.tools
# défaut : absent
# Le modèle appelle des outils
tools = false

# cle: profiles.*.models.*.vision
# défaut : absent
# Le modèle accepte une image. Si cette clé est absente, input peut la déduire
vision = false

# cle: profiles.*.multi_agent_system
# défaut : absent
# Système multi-agent

[profiles.exemple.multi_agent_system]
# cle: profiles.*.multi_agent_system.cost_warning_threshold_percent
# défaut : 0.8
# Seuil d'avertissement du coût
cost_warning_threshold_percent = 0.8

# cle: profiles.*.multi_agent_system.default_strategy
# défaut : hierarchical
# Stratégie
default_strategy = "sequential"

# cle: profiles.*.multi_agent_system.enabled
# défaut : false
# Système multi-agent
enabled = false

# cle: profiles.*.multi_agent_system.graceful_cost_overflow
# défaut : true
# Arrêt propre au plafond
graceful_cost_overflow = true

# cle: profiles.*.multi_agent_system.max_iterations
# défaut : 5
# Itérations
max_iterations = 5

# cle: profiles.*.multi_agent_system.max_workflow_cost_usd
# défaut : 0
# Plafond de coût, 0 pour désactiver
max_workflow_cost_usd = 0

# cle: profiles.*.multi_agent_system.parallel_agents
# défaut : 3
# Agents en parallèle
parallel_agents = 3

# cle: profiles.*.multi_agent_system.timeout_ms
# défaut : 600000
# Délai d'un flux, en millisecondes
timeout_ms = 600000

# cle: profiles.*.multi_agent_system.coordination
# défaut : absent
# Coordinateur

[profiles.exemple.multi_agent_system.coordination]
# cle: profiles.*.multi_agent_system.coordination.auto_resolve_enabled
# défaut : false
# Résolution automatique des conflits
auto_resolve_enabled = false

# cle: profiles.*.multi_agent_system.coordination.auto_resolve_strategy
# défaut : none
# Stratégie de résolution
auto_resolve_strategy = "prefer-reviewer"

# cle: profiles.*.multi_agent_system.coordination.checkpoint_interval
# défaut : 5
# Tâches entre deux points de reprise
checkpoint_interval = 5

# cle: profiles.*.multi_agent_system.coordination.conflict_timeout
# défaut : 30000
# Délai de conflit, en millisecondes
conflict_timeout = 30000

# cle: profiles.*.multi_agent_system.coordination.enable_adaptive_allocation
# défaut : true
# Répartition adaptative
enable_adaptive_allocation = true

# cle: profiles.*.multi_agent_system.coordination.enable_conflict_resolution
# défaut : true
# Détection de conflits
enable_conflict_resolution = true

# cle: profiles.*.multi_agent_system.coordination.enable_learning
# défaut : true
# Apprentissage de la répartition
enable_learning = true

# cle: profiles.*.multi_agent_system.coordination.enable_per_workflow_stop
# défaut : false
# Arrêt d'un seul flux
enable_per_workflow_stop = false

# cle: profiles.*.multi_agent_system.coordination.enable_persistence
# défaut : false
# Conserver les métriques
enable_persistence = false

# cle: profiles.*.multi_agent_system.coordination.enabled
# défaut : false
# Coordinateur avancé
enabled = false

# cle: profiles.*.multi_agent_system.coordination.history_size
# défaut : 50
# Taille de l'historique
history_size = 50

# cle: profiles.*.multi_agent_system.coordination.max_concurrent_workflows
# défaut : 1
# Flux simultanés
max_concurrent_workflows = 1

# cle: profiles.*.multi_agent_system.coordination.max_parallel_per_agent
# défaut : 2
# Tâches parallèles par agent
max_parallel_per_agent = 2

# cle: profiles.*.multi_agent_system.coordination.metrics_ttl_days
# défaut : 30
# Jours avant qu'une métrique soit périmée
metrics_ttl_days = 30

# cle: profiles.*.multi_agent_system.coordination.min_assignment_confidence
# défaut : 0.6
# Confiance minimale
min_assignment_confidence = 0.6

# cle: profiles.*.multi_agent_system.coordination.queue_policy
# défaut : queue
# File pleine
queue_policy = "queue"

# cle: profiles.*.multi_agent_system.sessions
# défaut : absent
# Registre de sessions

[profiles.exemple.multi_agent_system.sessions]
# cle: profiles.*.multi_agent_system.sessions.enable_persistence
# défaut : true
# Écrire les sessions
enable_persistence = true

# cle: profiles.*.multi_agent_system.sessions.enabled
# défaut : false
# Registre de sessions
enabled = false

# cle: profiles.*.multi_agent_system.sessions.idle_timeout_minutes
# défaut : 30
# Inactivité avant nettoyage
idle_timeout_minutes = 30

# cle: profiles.*.multi_agent_system.sessions.max_per_workflow
# défaut : 10
# Sous-agents par flux
max_per_workflow = 10

# cle: profiles.*.multi_agent_system.sessions.max_sessions
# défaut : 1000
# Sessions conservées
max_sessions = 1000

# cle: profiles.*.multi_agent_system.sessions.max_spawn_per_minute
# défaut : 0
# Créations par minute, 0 pour désactiver
max_spawn_per_minute = 0

# cle: profiles.*.multi_agent_system.sessions.require_confirmation_for_send
# défaut : false
# Confirmer un envoi
require_confirmation_for_send = false

# cle: profiles.*.multi_agent_system.sessions.require_confirmation_for_spawn
# défaut : false
# Confirmer une création
require_confirmation_for_spawn = false

# cle: profiles.*.providers
# défaut : absent
# Fournisseurs

# cle: profiles.*.providers.*
# défaut : absent

[profiles.exemple.providers.exemple]
# cle: profiles.*.providers.*.api_key_env
# défaut : absent
# Nom de la variable qui porte la clé, jamais la clé elle-même
api_key_env = "EXAMPLE_API_KEY"

# cle: profiles.*.providers.*.base_url
# défaut : absent
# URL de base du fournisseur
base_url = "https://example.invalid/v1"

# cle: profiles.*.providers.*.enabled
# défaut : absent
# Fournisseur utilisable
enabled = false

# cle: profiles.*.providers.*.type
# défaut : absent
# Protocole du fournisseur
type = "openai"

# cle: profiles.*.sandbox
# défaut : absent
# Bac à sable

[profiles.exemple.sandbox]
# cle: profiles.*.sandbox.backend
# défaut : absent
# Moteur d'isolation choisi
backend = "bwrap"

# cle: profiles.*.sandbox.mode
# défaut : absent
# Posture du bac à sable. all est plus fermé que off
mode = "off"

# cle: profiles.*.surface
# défaut : absent
# Surface visible

[profiles.exemple.surface]
# cle: profiles.*.surface.hidden_capabilities
# défaut : vide
# Domaines masqués de la surface
hidden_capabilities = ["film"]

# cle: profiles.*.team_session
# défaut : absent
# Session d'équipe

[profiles.exemple.team_session]
# cle: profiles.*.team_session.auto_reconnect
# défaut : true
# Reconnexion automatique
auto_reconnect = true

# cle: profiles.*.team_session.enable_encryption
# défaut : true
# Chiffrer les sessions
enable_encryption = true

# cle: profiles.*.team_session.enabled
# défaut : false
# Sessions d'équipe
enabled = false

# cle: profiles.*.team_session.encryption_key
# défaut : absent
# Référence de la clé de chiffrement, jamais la clé en clair
encryption_key = "exemple"

# cle: profiles.*.team_session.heartbeat_interval
# défaut : 30000
# Intervalle de battement, en millisecondes
heartbeat_interval = 30000

# cle: profiles.*.team_session.max_reconnect_attempts
# défaut : 10
# Tentatives de reconnexion
max_reconnect_attempts = 10

# cle: profiles.*.team_session.reconnect_interval
# défaut : 5000
# Délai de reconnexion, en millisecondes
reconnect_interval = 5000

# cle: profiles.*.team_session.server_url
# défaut : absent
# URL de synchronisation
server_url = "https://example.invalid/v1"

# cle: profiles.*.tool_config
# défaut : absent
# Outils

# cle: profiles.*.tool_config.*
# défaut : absent

[profiles.exemple.tool_config.exemple]
# cle: profiles.*.tool_config.*.allowlist
# défaut : absent
# Motifs autorisés
allowlist = ["exemple"]

# cle: profiles.*.tool_config.*.denylist
# défaut : absent
