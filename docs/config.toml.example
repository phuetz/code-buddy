# Posture du bac à sable. all est plus fermé que off
[profiles.exemple.sandbox]
mode = "off"

# cle: profiles.*.surface
# défaut : absent
# Surface visible

# cle: profiles.*.surface.hidden_capabilities
# défaut : 
# Domaines masqués de la surface
[profiles.exemple.surface]
hidden_capabilities = ["film"]

# cle: profiles.*.team_session
# défaut : absent
# Session d'équipe

# cle: profiles.*.team_session.auto_reconnect
# défaut : true
# Reconnexion automatique
[profiles.exemple.team_session]
auto_reconnect = true

# cle: profiles.*.team_session.enable_encryption
# défaut : true
# Chiffrer les sessions
[profiles.exemple.team_session]
enable_encryption = true

# cle: profiles.*.team_session.enabled
# défaut : false
# Sessions d'équipe
[profiles.exemple.team_session]
enabled = false

# cle: profiles.*.team_session.encryption_key
# défaut : absent
# Référence de la clé de chiffrement, jamais la clé en clair
[profiles.exemple.team_session]
encryption_key = "exemple"

# cle: profiles.*.team_session.heartbeat_interval
# défaut : 30000
# Intervalle de battement, en millisecondes
[profiles.exemple.team_session]
heartbeat_interval = 30000

# cle: profiles.*.team_session.max_reconnect_attempts
# défaut : 10
# Tentatives de reconnexion
[profiles.exemple.team_session]
max_reconnect_attempts = 10

# cle: profiles.*.team_session.reconnect_interval
# défaut : 5000
# Délai de reconnexion, en millisecondes
[profiles.exemple.team_session]
reconnect_interval = 5000

# cle: profiles.*.team_session.server_url
# défaut : absent
# URL de synchronisation
[profiles.exemple.team_session]
server_url = "https://example.invalid/v1"

# cle: profiles.*.tool_config
# défaut : absent
# Outils

# cle: profiles.*.tool_config.*
# défaut : absent

# cle: profiles.*.tool_config.*.allowlist
# défaut : absent
# Motifs autorisés
[profiles.exemple.tool_config.exemple]
allowlist = ["exemple"]

# cle: profiles.*.tool_config.*.denylist
# défaut : absent
# Motifs refusés
[profiles.exemple.tool_config.exemple]
denylist = ["exemple"]

# cle: profiles.*.tool_config.*.permission
# défaut : absent
# Niveau d'autorisation
[profiles.exemple.tool_config.exemple]
permission = "always"

# cle: profiles.*.tool_config.*.settings
# défaut : absent
# Réglages propres à l'outil

# cle: profiles.*.tool_config.*.settings.*
# défaut : absent
[profiles.exemple.tool_config.exemple.settings]
exemple = "exemple"

# cle: profiles.*.tool_config.*.timeout
# défaut : absent
# Délai en secondes
[profiles.exemple.tool_config.exemple]
timeout = 0

# cle: profiles.*.ui
# défaut : absent
# Interface

# cle: profiles.*.ui.show_cost
# défaut : true
# Afficher le coût
[profiles.exemple.ui]
show_cost = true

# cle: profiles.*.ui.show_tokens
# défaut : true
# Afficher le compteur de jetons
[profiles.exemple.ui]
show_tokens = true

# cle: profiles.*.ui.sound_effects
# défaut : false
# Sons d'interface
[profiles.exemple.ui]
sound_effects = false

# cle: profiles.*.ui.streaming
# défaut : true
# Réponse en flux
[profiles.exemple.ui]
streaming = true

# cle: profiles.*.ui.theme
# défaut : default
# Nom du thème
[profiles.exemple.ui]
theme = "default"

# cle: profiles.*.ui.vim_keybindings
# défaut : false
# Raccourcis vim
[profiles.exemple.ui]
vim_keybindings = false

# cle: providers
# défaut : absent
# Fournisseurs

# cle: providers.*
# défaut : absent

# cle: providers.*.api_key_env
# défaut : absent
# Nom de la variable qui porte la clé, jamais la clé elle-même
[providers.exemple]
api_key_env = "EXAMPLE_API_KEY"

# cle: providers.*.base_url
# défaut : absent
# URL de base du fournisseur
[providers.exemple]
base_url = "https://example.invalid/v1"

# cle: providers.*.enabled
# défaut : absent
# Fournisseur utilisable
[providers.exemple]
enabled = false

# cle: providers.*.type
# défaut : absent
# Protocole du fournisseur
[providers.exemple]
type = "openai"

# cle: sandbox
# défaut : absent
# Bac à sable

# cle: sandbox.backend
# défaut : absent
# Moteur d'isolation choisi
[sandbox]
backend = "bwrap"

# cle: sandbox.mode
# défaut : absent
# Posture du bac à sable. all est plus fermé que off
[sandbox]
mode = "off"

# cle: surface
# défaut : absent
# Surface visible

# cle: surface.hidden_capabilities
# défaut : 
# Domaines masqués de la surface
[surface]
hidden_capabilities = ["film"]

# cle: team_session
# défaut : absent
# Session d'équipe

# cle: team_session.auto_reconnect
# défaut : true
# Reconnexion automatique
[team_session]
auto_reconnect = true

# cle: team_session.enable_encryption
# défaut : true
# Chiffrer les sessions
[team_session]
enable_encryption = true

# cle: team_session.enabled
# défaut : false
# Sessions d'équipe
[team_session]
enabled = false

# cle: team_session.encryption_key
# défaut : absent
# Référence de la clé de chiffrement, jamais la clé en clair
[team_session]
encryption_key = "exemple"

# cle: team_session.heartbeat_interval
# défaut : 30000
# Intervalle de battement, en millisecondes
[team_session]
heartbeat_interval = 30000

# cle: team_session.max_reconnect_attempts
# défaut : 10
# Tentatives de reconnexion
[team_session]
max_reconnect_attempts = 10

# cle: team_session.reconnect_interval
# défaut : 5000
# Délai de reconnexion, en millisecondes
[team_session]
reconnect_interval = 5000

# cle: team_session.server_url
# défaut : absent
# URL de synchronisation
[team_session]
server_url = "https://example.invalid/v1"

# cle: tool_config
# défaut : absent
# Outils

# cle: tool_config.*
# défaut : absent

# cle: tool_config.*.allowlist
# défaut : absent
# Motifs autorisés
[tool_config.exemple]
allowlist = ["exemple"]

# cle: tool_config.*.denylist
# défaut : absent
# Motifs refusés
[tool_config.exemple]
denylist = ["exemple"]

# cle: tool_config.*.permission
# défaut : absent
# Niveau d'autorisation
[tool_config.exemple]
permission = "always"

# cle: tool_config.*.settings
# défaut : absent
# Réglages propres à l'outil

# cle: tool_config.*.settings.*
# défaut : absent
[tool_config.exemple.settings]
exemple = "exemple"

# cle: tool_config.*.timeout
# défaut : absent
# Délai en secondes
[tool_config.exemple]
timeout = 0

# cle: ui
# défaut : absent
# Interface

# cle: ui.show_cost
# défaut : true
# Afficher le coût
[ui]
show_cost = true

# cle: ui.show_tokens
# défaut : true
# Afficher le compteur de jetons
[ui]
show_tokens = true

# cle: ui.sound_effects
# défaut : false
# Sons d'interface
[ui]
sound_effects = false

# cle: ui.streaming
# défaut : true
# Réponse en flux
[ui]
